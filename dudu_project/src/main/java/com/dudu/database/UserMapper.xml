<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dudu.database.UserMapper">

    <!-- ===================== -->
    <!-- 회원가입 -->
    <!-- ===================== -->
    <insert id="join" parameterType="com.dudu.model.User">
        INSERT INTO TB_USER
        (
            USER_ID,
            USER_PW,
            USER_NM,
            USER_TEL,
            LAST_DT,
            JOIN_DT,
            SAFETY_SCORE,
            SAFETY_GR,
            BLACK_YN
        )
        VALUES
        (
            #{USER_ID},
            #{USER_PW},
            #{USER_NM},
            #{USER_TEL},
            NULL,
            SYSDATE,
            100,
            1,
            'N'
        )
    </insert>

    <!-- ===================== -->
    <!-- 로그인 -->
    <!-- ===================== -->
    <select id="login"
            parameterType="com.dudu.model.User"
            resultType="com.dudu.model.User">
        SELECT
            USER_ID,
            USER_PW,
            USER_NM,
            USER_TEL,
            LAST_DT,
            JOIN_DT,
            SAFETY_SCORE,
            SAFETY_GR,
            BLACK_YN
        FROM TB_USER
        WHERE TRIM(USER_ID) = TRIM(#{USER_ID})
          AND TRIM(USER_PW) = TRIM(#{USER_PW})
    </select>

</mapper>
